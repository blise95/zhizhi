# 智质通 AI 问答模块环境配置

# 模型提供商：fastembed / openai / ollama / zhipu
# fastembed: 本地轻量 ONNX Embedding，无需 API Key，推荐
MODEL_PROVIDER=fastembed

# fastembed 本地模型配置（中文推荐 BAAI/bge-small-zh-v1.5）
FASTEMBED_MODEL=BAAI/bge-small-zh-v1.5

# OpenAI 兼容接口配置（支持 OpenAI、智谱、通义千问等）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama 本地模型配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b

# 智谱 AI 配置（OpenAI 兼容模式）
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_CHAT_MODEL=glm-4-flash

# 向量库路径
VECTOR_STORE_PATH=./data/vector_store

# 前端业务数据 API 地址（用于查询当前系统质量数据）
BUSINESS_API_URL=http://localhost:5173/api
