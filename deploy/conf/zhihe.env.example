# 复制到 /opt/zhizhi/conf/zhihe.env ，chmod 600
# 不要把真实 API Key 提交到 Git。

LLM_PROVIDER=zhipu
ZHIPU_API_KEY=在这里填智谱API Key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flash

# 知识库 Embedding（远程，不要在 8GB 机器上跑 Ollama）
EMBEDDING_PROVIDER=zhipu
ZHIPU_EMBEDDING_MODEL=embedding-2

ZHIHE_LOG_DIR=/opt/zhizhi/logs/zhihe
VECTOR_STORE_PATH=/opt/zhizhi/zhihe-data/vector_store
KNOWLEDGE_CHUNKS_PATH=/opt/zhizhi/zhihe-data/knowledge_chunks.json
DOC_RATING=/opt/zhizhi/src/ai-assistant/docs/卷烟外在质量分级及评级规定.pdf
DOC_DEFECT=/opt/zhizhi/src/ai-assistant/docs/卷烟外在质量缺陷判定.pdf
