[Unit]
Description=Zhizhi Zhihe AI Assistant
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
EnvironmentFile=-/opt/zhizhi/conf/zhihe.env
WorkingDirectory=/opt/zhizhi/src/ai-assistant
ExecStart=/opt/zhizhi/zhihe-venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
